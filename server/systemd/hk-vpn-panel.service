[Unit]
Description=HK VPN Suite control panel
After=network-online.target wg-quick@wg0.service strongswan-swanctl.service
Wants=network-online.target

[Service]
Type=simple
User=hkvpn
Group=hkvpn
EnvironmentFile=/etc/hk-vpn/panel.env
WorkingDirectory=/opt/hk-vpn-suite/server
ExecStart=/usr/bin/python3 -m app.main
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hk-vpn-panel /etc/hk-vpn

[Install]
WantedBy=multi-user.target
