[Unit]
Description=HK VPN Suite control panel
After=network-online.target wg-quick@wg0.service strongswan-swanctl.service
Wants=network-online.target

[Service]
Type=simple
User=hkvpn
Group=hkvpn
EnvironmentFile=/etc/hk-vpn/panel.env
WorkingDirectory=/opt/hk-vpn-suite/server
ExecStart=/usr/bin/python3 -m app.main
Restart=on-failure
RestartSec=3
# The panel runs unprivileged, but its deliberately narrow sudoers rule invokes
# vpnctl.py as root to update WireGuard/StrongSwan. Do not set
# NoNewPrivileges here: it would disable that approved privilege transition.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# hkvpn cannot write /etc/swanctl by Unix permissions; this writable mount is
# solely for the narrowly scoped root vpnctl helper invoked via sudo.
ReadWritePaths=/var/lib/hk-vpn-panel /etc/hk-vpn /etc/swanctl

[Install]
WantedBy=multi-user.target
