<Window x:Class="HKVpnClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HK VPN" Width="470" Height="500" WindowStartupLocation="CenterScreen" Background="#09111E">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="HK VPN" FontSize="30" FontWeight="SemiBold" Foreground="#EDF5FF"/><TextBlock Text="Hong Kong · WireGuard" Margin="0,5,0,25" Foreground="#AEBFD0"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="控制台地址" Foreground="#C6DBE9"/><TextBox x:Name="EndpointBox" Margin="0,7,0,15" Padding="10" Text="https://panel.example.com"/><TextBlock Text="管理密码（首次获取配置时使用）" Foreground="#C6DBE9"/><PasswordBox x:Name="PasswordBox" Margin="0,7,0,4" Padding="10"/></StackPanel>
    <TextBlock Grid.Row="2" x:Name="StatusText" Text="未连接" FontSize="17" Foreground="#8EE4FF" Margin="0,24,0,10"/>
    <TextBlock Grid.Row="3" TextWrapping="Wrap" Foreground="#AEBFD0" Text="首次连接会调用已安装的官方 WireGuard 程序创建系统隧道。若电脑未安装 WireGuard，会提示你先安装。" />
    <StackPanel Grid.Row="4"><Button x:Name="ConnectButton" Click="ConnectButton_Click" Background="#42C6F2" Foreground="#041017" Padding="12" FontWeight="Bold" Content="Connect"/><Button Margin="0,10,0,0" Padding="9" Click="Ikev2Button_Click" Content="查看系统 IKEv2 备用方式"/></StackPanel>
  </Grid>
</Window>
